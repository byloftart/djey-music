# Public client configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Branding (all optional; these are the shipped defaults)
NEXT_PUBLIC_SITE_NAME="DJey Music"
NEXT_PUBLIC_ARTIST_NAME="DJey"
NEXT_PUBLIC_SITE_DESCRIPTION="Original music by DJey."

# Server-only owner configuration; never expose these values to browser code
OWNER_EMAIL_ALLOWLIST=
OWNER_LOGIN=
OWNER_LOGIN_EMAIL=

# Upload policy
MAX_AUDIO_UPLOAD_BYTES=104857600
MAX_COVER_UPLOAD_BYTES=10485760
